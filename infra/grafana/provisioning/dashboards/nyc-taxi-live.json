    {
      "id": 8,
      "type": "geomap",
      "title": "Where the taxis are · pickups, last sim hour",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT z.zone AS zone, z.lat AS latitude, z.lon AS longitude, count() AS pickups\nFROM taxi.trips AS t\nINNER JOIN taxi.zones AS z ON z.location_id = t.pu_location_id\nWHERE t.pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 1 HOUR\n  AND z.lat IS NOT NULL\nGROUP BY z.zone, z.lat, z.lon"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#c4bdf5"
          }
        },
        "overrides": []
      },
