    {
      "id": 7,
      "type": "trend",
      "title": "Trips per minute by borough · last 6 sim hours",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Trips per sim minute by pickup borough, last 6 sim hours.\n-- argMax(…, emitted_at) keeps the latest version of a window the processor re-emitted.\nSELECT toUnixTimestamp64Milli(window_start) AS t,\n       sumIf(trips, borough = 'Manhattan') AS `Manhattan`,\n       sumIf(trips, borough = 'Brooklyn') AS `Brooklyn`,\n       sumIf(trips, borough = 'Queens') AS `Queens`,\n       sumIf(trips, borough = 'Bronx') AS `Bronx`,\n       sumIf(trips, borough = 'Staten Island') AS `Staten Island`\nFROM\n(\n    SELECT window_start, borough, argMax(trips, emitted_at) AS trips\n    FROM taxi.agg_borough_minute\n    WHERE window_start >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 6 HOUR\n    GROUP BY window_start, borough\n)\nGROUP BY window_start\nORDER BY window_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal"
            },
            "axisBorderShow": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Manhattan"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Brooklyn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Queens"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bronx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Staten Island"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EWR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008300"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(Manhattan|Brooklyn|Queens|Bronx|Staten Island)$/"
            },
            "properties": [
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "t",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
