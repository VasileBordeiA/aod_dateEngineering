    {
      "id": 12,
      "type": "bargauge",
      "title": "",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 7,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- A trip can fail several rules, so it counts once per reason.\nSELECT reason, count() AS trips\nFROM taxi.trips_rejected\nARRAY JOIN reasons AS reason\nWHERE pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 24 HOUR\nGROUP BY reason\nORDER BY trips DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
