    {
      "id": 10,
      "type": "barchart",
      "title": "Card tip % by borough · last 24 sim hours",
      "gridPos": {
        "x": 7,
        "y": 16,
        "w": 5,
        "h": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Tips are only recorded for card payments, so only card trips count.\nSELECT pu_borough AS borough, round(avg(tip_pct), 1) AS avg_tip_pct, count() AS card_trips\nFROM taxi.trips\nWHERE is_card AND tip_pct IS NOT NULL\n  AND pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 24 HOUR\n  AND pu_borough NOT IN ('Unknown', 'N/A')\nGROUP BY borough\nHAVING card_trips >= 30\nORDER BY avg_tip_pct DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
