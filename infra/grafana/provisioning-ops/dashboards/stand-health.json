          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ops"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(count() / 60, 1) AS rows_per_s\nFROM taxi.trips\nWHERE stored_at >= now64(3) - INTERVAL 60 SECOND"
