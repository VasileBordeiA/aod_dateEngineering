  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Freshness",
      "description": "now64() − max(stored_at). Green < 3 s, red > 10 s.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ops"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Wall time since the newest row was stored. Only recent sim rows are read (pickup_ts is the sort key).\nSELECT dateDiff('millisecond', max(stored_at), now64(3)) AS freshness_ms\nFROM taxi.trips\nWHERE pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 1 HOUR"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 3000
              },
              {
                "color": "#d03b3b",
                "value": 10000
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 40,
          "titleSize": 16
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingest rate (rows/s, last 60 s)",
      "description": "Red when nothing was stored in the last minute.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
