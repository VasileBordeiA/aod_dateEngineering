    {
      "id": 4,
      "type": "stat",
      "title": "Sim speed (last 60 s)",
      "description": "Expect ≈ REPLAY_SPEED (60). Much higher = backfill; empty = paused or stalled.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ops"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Sim seconds covered ÷ wall seconds elapsed, over replay rows stored in the last minute. Expect ≈ REPLAY_SPEED.\nSELECT round(dateDiff('millisecond', min(pickup_ts), max(pickup_ts))\n             / nullIf(dateDiff('millisecond', min(stored_at), max(stored_at)), 0)) AS sim_speed\nFROM taxi.trips\nWHERE source = 'replay' AND stored_at >= now64(3) - INTERVAL 60 SECOND"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 40,
          "titleSize": 16
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rejected share (last 24 sim hours)",
      "description": "Info only: rejection is healthy behaviour.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ops"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(100 * rejected / (rejected + valid), 2) AS rejected_pct\nFROM\n(\n    SELECT (SELECT count() FROM taxi.trips_rejected\n            WHERE pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 24 HOUR) AS rejected,\n           (SELECT count() FROM taxi.trips\n            WHERE pickup_ts >= (SELECT now_ts FROM taxi.sim_now) - INTERVAL 24 HOUR) AS valid\n)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "decimals": 2
        },
        "overrides": []
