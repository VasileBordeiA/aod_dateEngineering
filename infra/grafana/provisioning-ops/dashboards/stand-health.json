            "uid": "clickhouse-ops"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- produced_at (replayer) → stored_at (ClickHouse), both wall clock.\nSELECT quantile(0.95)(dateDiff('millisecond', produced_at, stored_at)) AS p95_ms\nFROM taxi.trips\nWHERE stored_at >= now64(3) - INTERVAL 5 MINUTE"
