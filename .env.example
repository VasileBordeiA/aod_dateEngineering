# Copy to .env and fill in the blanks. Never commit .env.
# Every key is documented in the spec named in brackets.

# ── General ───────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=nyctaxi
# URL printed in the ride QR code: the laptop's static IP on the stand router [09]
STAND_PUBLIC_URL=http://192.168.8.10
# Stand Wi-Fi shown as a QR code on /qr [08][09]
STAND_WIFI_SSID=NYC-Taxi-Live
STAND_WIFI_PASSWORD=
# Protects /api/admin/* and the replayer control API [06][09]
ADMIN_TOKEN=

# ── Data [01] ─────────────────────────────────────────────────────────────
TLC_MONTH=2025-10
DATA_DIR=./data

# ── Redpanda [02] ─────────────────────────────────────────────────────────
KAFKA_BROKERS=redpanda:9092
# Per-partition size retention (time retention can't work: records carry 2025 sim timestamps)
TOPIC_RETENTION_BYTES=1073741824

# ── Replayer [01] ─────────────────────────────────────────────────────────
# Sim seconds per wall second: 60 means 1 data hour = 1 wall minute. "max" = backfill.
REPLAY_SPEED=60
# Sim time to start from on a fresh start (ignored when a state file exists)
REPLAY_START_TS=2025-10-07T07:00:00
# Stop when the sim clock reaches this time (backfill only; empty = run forever)
REPLAY_UNTIL_TS=
# Shift sim time by this many days on each loop (multiple of 7 keeps weekdays)
REPLAY_LOOP_OFFSET_DAYS=35
# Fraction of replay trips that get a trace_id (feeds the latency panel)
REPLAY_TRACE_SAMPLE_RATE=0.001
REPLAY_CLOCK_INTERVAL_S=1
REPLAY_STATE_PATH=/data/state/replayer.json
REPLAY_CONTROL_PORT=8001

# ── Stream processor [03] ─────────────────────────────────────────────────
PROCESSOR_CONSUMER_GROUP=processor-v1
PROCESSOR_COMMIT_INTERVAL_S=1
# Sim-time grace period before a 1-minute window closes
PROCESSOR_WINDOW_GRACE_S=180
PROCESSOR_TIP_MAX_ABS=100
PROCESSOR_ZONES_PATH=/data/zones.csv
# Quix state (RocksDB windows); a Docker volume in compose
PROCESSOR_STATE_DIR=/state

# ── ClickHouse [04] ───────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=taxi
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_INGEST_USER=ingest_writer
CLICKHOUSE_INGEST_PASSWORD=
CLICKHOUSE_AGENT_USER=agent_ro
CLICKHOUSE_AGENT_PASSWORD=
# The api's own reads (estimates, queryable poll, trace history): agent_ro's grants, its own quota (ADR-019)
CLICKHOUSE_TRACE_USER=trace_ro
CLICKHOUSE_TRACE_PASSWORD=
CLICKHOUSE_GRAFANA_USER=grafana_ro
CLICKHOUSE_GRAFANA_PASSWORD=
# Operator-only Stand Health (grafana-ops on 127.0.0.1:3002): may read agent_log and system.query_log [05]
CLICKHOUSE_OPS_USER=grafana_ops
CLICKHOUSE_OPS_PASSWORD=

# ── LLM [06] ──────────────────────────────────────────────────────────────
# Providers are tried in this order. Both speak the OpenAI-compatible
# /v1/chat/completions API with tool calling.
LLM_ORDER=local,internal
# local = Ollama running NATIVELY on the Mac host (Metal GPU), not in Docker
LLM_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=taxi-qwen2.5-coder-14b
# internal = the company AI gateway (OpenAI-compatible). Leave blank to disable.
LLM_INTERNAL_BASE_URL=
LLM_INTERNAL_API_KEY=
LLM_INTERNAL_MODEL=
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0
# Seconds between GET /models health checks per provider (2 failures = unhealthy, 1 success = healthy)
LLM_HEALTH_INTERVAL_S=15

# ── Agent [06] ────────────────────────────────────────────────────────────
# tools = multi-step tool calling; oneshot = schema in prompt, single JSON answer
AGENT_MODE=oneshot
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_REPAIRS=2
AGENT_MAX_QUESTION_CHARS=300
AGENT_TOTAL_TIMEOUT_S=45
AGENT_RATE_LIMIT_PER_MIN=10
# Parallel LLM runs; extra requests queue with a "you're next" status
AGENT_MAX_CONCURRENCY=2
# Waiting requests beyond this get RATE_LIMITED immediately
AGENT_MAX_QUEUE=6
# Golden set (suggested questions + cached reference SQL); mounted read-only into the api container
AGENT_GOLDEN_PATH=/app/evals/agent_golden_questions.yaml

# ── Trace your ride [07] ──────────────────────────────────────────────────
RIDES_RATE_LIMIT_PER_MIN=3
# Rides per minute across all phones together (the per-IP limit is RIDES_RATE_LIMIT_PER_MIN)
RIDES_GLOBAL_PER_MIN=30
TRACE_HISTORY_TTL_S=3600
TRACE_QUERYABLE_POLL_MS=250
# Per-IP reads per minute across GET /api/rides/estimate, GET /api/trace/{id} and each trace WebSocket connect
TRACE_READ_RATE_LIMIT_PER_MIN=120

# ── Web [08] ──────────────────────────────────────────────────────────────
# Grafana kiosk link on the hub page (baked in at image build time)
NEXT_PUBLIC_GRAFANA_PATH=/grafana/d/nyc-taxi-live?kiosk&refresh=5s
# Dev only: where the browser opens WebSockets when the api isn't behind the same origin (pnpm dev → ws://localhost:8000).
# Leave empty on the stand: Caddy serves web and api on one origin.
NEXT_PUBLIC_API_WS_ORIGIN=

# ── Grafana [05] ──────────────────────────────────────────────────────────
# Admin login for both Grafanas. The public one is anonymous read-only; grafana-ops always needs this login.
GRAFANA_ADMIN_PASSWORD=
